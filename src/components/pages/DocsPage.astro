---
/**
 * 使用教程中心（/zh/docs/、/en/docs/）：
 *   1) 三步走（怎么用 AiBOX 装一个应用）
 *   2) 每个应用的独立教程页（落地页内含该应用的完整教程）
 *   3) 通用指南（macOS Gatekeeper / Windows SmartScreen / 网络自检）
 *
 * **为什么要有这个页**：安装器装完后的主 CTA「打开教程」原本指向 `/docs`（404），
 * 小白刚装完第一个应用就被弹到 404 页 → 直接判定「软件是坏的」。
 * 本页是那个 CTA 的真实落点。
 */
import { fetchRegistry, landingHref, taglineFor } from '../../data/registry';
import { pt, type Lang } from '../../i18n/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = pt(lang).docs;

const registry = await fetchRegistry();
const apps = registry.apps;

// 通用指南（站内已有页）
const guides: { href: string; label: string }[] = [
  { href: `/${lang}/guides/gatekeeper/`, label: c.guideGatekeeper },
  { href: `/${lang}/guides/smartscreen/`, label: c.guideSmartscreen },
  { href: `/${lang}/guides/network-selfcheck/`, label: c.guideNetwork },
];

const title = c.title;
const description = c.description;
---

<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://aibox.im/${lang}/docs/`} />
    <link rel="alternate" hreflang="en" href="/en/docs/" />
    <link rel="alternate" hreflang="zh" href="/zh/docs/" />
    <link rel="alternate" hreflang="x-default" href="/en/docs/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body style="background:#0A0A0A;color:#F2F4F7;font-family:system-ui,-apple-system,sans-serif;margin:0">
    <main class="mx-auto flex max-w-3xl flex-col gap-8 px-5 py-12">
      <header class="flex flex-col gap-2">
        <p class="font-mono text-xs uppercase tracking-widest" style="color:#B6FB50">AiBOX.im</p>
        <h1 class="text-3xl font-semibold" style="color:#FBF6E2">{title}</h1>
        <p class="text-sm" style="color:#9BA3AF">{description}</p>
        <p class="text-xs" style="color:#6B7280">
          <a href={`/${lang}/download/`} style="color:#B6FB50">{c.downloadCta}</a>
          ·
          <a href={`/${lang}/apps/`} style="color:#B6FB50">{c.catalogCta}</a>
          ·
          <a href={`/${lang}/feedback/`} style="color:#B6FB50">{c.feedbackCta}</a>
        </p>
      </header>

      <section class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold" style="color:#FBF6E2">{c.stepsTitle}</h2>
        <ol class="flex list-decimal flex-col gap-2 pl-5 text-sm" style="color:#D1D5DB">
          <li>{c.step1}</li>
          <li>{c.step2}</li>
          <li>{c.step3}</li>
        </ol>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold" style="color:#FBF6E2">{c.appsTitle}</h2>
        <p class="text-sm" style="color:#9BA3AF">{c.appsDesc}</p>
        <ul class="grid gap-3 sm:grid-cols-2" style="list-style:none;padding:0;margin:0">
          {apps.map((a) => (
            <li>
              <a
                href={landingHref(lang, a.id)}
                class="flex flex-col gap-1 rounded border p-3 no-underline hover:border-[#B6FB50]"
                style="border-color:#2A2E33;background:#14161A"
              >
                <span class="text-sm font-semibold" style="color:#FBF6E2">{a.name}</span>
                <span class="text-xs" style="color:#9BA3AF">
                  {taglineFor(a, lang) ?? a.summary ?? ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold" style="color:#FBF6E2">{c.guidesTitle}</h2>
        <ul class="flex flex-col gap-2 text-sm" style="list-style:none;padding:0;margin:0">
          {guides.map((g) => (
            <li>
              <a href={g.href} style="color:#B6FB50">{g.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <footer class="border-t pt-6 text-xs" style="border-color:#2A2E33;color:#6B7280">
        <a href={`/${lang === 'zh' ? 'en' : 'zh'}/docs/`} style="color:#9BA3AF">
          {lang === 'zh' ? 'English' : '中文'}
        </a>
      </footer>
    </main>
  </body>
</html>
