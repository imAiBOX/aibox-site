---
// 专题页（collections）：把同一场景的应用串成一篇可读的选型指南
// 数据源 = src/data/registry.ts（构建时拉 GitHub registry，失败降级占位——I1 不变式）
// 专题内容 = i18n/pages.ts 的 collections 段；应用清单由 COLLECTIONS 定义（id 白名单）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AppCard from '../../components/AppCard.astro';
import PixelRule from '../../components/PixelRule.astro';
import { fetchRegistry, landingHref, taglineFor, type RegistryApp } from '../../data/registry';
import { pt, type Lang } from '../../i18n/pages';

/** 专题 → 应用 id 顺序（顺序即推荐顺序） */
const COLLECTIONS = {
  coding: ['cline', 'continue', 'aider', 'zed', 'codex', 'opencode', 'pi'],
} as const;

interface Props {
  lang: Lang;
  collection: keyof typeof COLLECTIONS;
}
const { lang, collection } = Astro.props;
const c = pt(lang).collections[collection];
const ids = COLLECTIONS[collection];

const registry = await fetchRegistry();

// 按白名单顺序取应用；registry 里没有的（尚未上架）直接跳过，避免出现空卡片
const picked: { app: RegistryApp; when: string; detail: string }[] = [];
for (const id of ids) {
  const app = registry.apps.find((a) => a.id === id);
  if (!app) continue;
  const item = (c.items as Record<string, { when: string; detail: string }>)[id];
  picked.push({
    app,
    when: item?.when ?? '',
    detail: item?.detail ?? taglineFor(app, lang) ?? app.summary ?? '',
  });
}

const title =
  lang === 'zh'
    ? 'AI 编程工具怎么选 - AiBOX 一键安装 | aibox.im'
    : 'Which AI coding tool should you use? — install with AiBOX | aibox.im';
const description =
  lang === 'zh'
    ? '七个 AI 编程工具横向对比：谁在 VS Code 里、谁在终端里、谁自带编辑器，一眼看清。全部可用 AiBOX 一键安装。'
    : 'Seven AI coding tools compared: the one that lives in VS Code, the one that lives in your terminal, the editor with AI built in. All installable with AiBOX.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <PageHeader title={c.title} lede={c.lede} />

  <section class="mx-auto max-w-6xl px-5 py-8">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <p class="m-0 max-w-2xl text-sm text-aibox-text2">{c.sourceNote}</p>
      <a href={`/${lang}/apps/`} class="btn-ghost">{c.backToCatalog}</a>
    </div>

    {
      picked.length === 0 ? (
        <p class="m-0 text-aibox-text2">—</p>
      ) : (
        <>
          {/* 选型速览：先说「我该选哪个」，再给详情 */}
          <h2 class="mt-2 mb-4 font-[family-name:var(--font-display)] text-2xl font-semibold text-aibox-cream">
            {c.pickTitle}
          </h2>
          <ol class="m-0 mb-12 grid list-none gap-3 p-0">
            {picked.map(({ app, when, detail }, i) => (
              <li class="border border-aibox-line bg-aibox-raised p-4" style="border-radius:4px">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-xs text-aibox-green">{String(i + 1).padStart(2, '0')}</span>
                  <a
                    href={landingHref(lang, app.id)}
                    class="font-[family-name:var(--font-display)] text-lg font-semibold text-aibox-cream no-underline hover:text-aibox-green"
                  >
                    {app.name}
                  </a>
                </div>
                <p class="m-0 mt-1 text-sm text-aibox-text1">{when}</p>
                <p class="m-0 mt-1 text-sm text-aibox-text2">{detail}</p>
              </li>
            ))}
          </ol>

          <PixelRule />

          {/* 卡片区：复用目录卡片，保持视觉一致 */}
          <h2 class="mt-8 mb-4 font-[family-name:var(--font-display)] text-2xl font-semibold text-aibox-cream">
            {c.title}
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {picked.map(({ app }) => (
              <AppCard app={app} lang={lang} live={registry.live} href={landingHref(lang, app.id)} />
            ))}
          </div>
        </>
      )
    }

    <div class="mt-12 border border-aibox-line bg-aibox-raised p-6" style="border-radius:4px">
      <h2 class="m-0 mb-2 font-[family-name:var(--font-display)] text-xl font-semibold text-aibox-cream">{c.ctaH}</h2>
      <p class="m-0 mb-4 text-sm text-aibox-text2">{c.sourceNote}</p>
      <a href={`/${lang}/download/`} class="btn-cta">{c.cta}</a>
    </div>
  </section>
</BaseLayout>
