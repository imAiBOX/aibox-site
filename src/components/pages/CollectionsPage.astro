---
// 专题页（collections）：把同一场景的应用串成一篇可读的选型指南
// 数据源 = src/data/registry.ts（构建时拉 GitHub registry，失败降级占位——I1 不变式）
// 专题内容 = i18n/pages.ts 的 collections 段（groups 分组 + items 白名单）
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AppCard from '../../components/AppCard.astro';
import PixelRule from '../../components/PixelRule.astro';
import { fetchRegistry, landingHref, taglineFor, type RegistryApp } from '../../data/registry';
import { pt, type Lang } from '../../i18n/pages';

/** 专题 → 分组 → 应用 id 顺序（顺序即推荐顺序） */
const COLLECTIONS = {
  coding: [
    { ids: ['cline', 'continue'] },
    { ids: ['aider', 'zed', 'codex', 'opencode', 'pi'] },
  ],
  localModels: [
    { ids: ['ollama', 'gpt4all', 'llamafile'] },
    { ids: ['chatbox', 'cherry-studio', 'lobechat'] },
  ],
} as const;

interface Props {
  lang: Lang;
  collection: keyof typeof COLLECTIONS;
}
const { lang, collection } = Astro.props;
const c = pt(lang).collections[collection];
const groupsMeta = c.groups;

const registry = await fetchRegistry();

type Item = { app: RegistryApp; when: string; detail: string };
const groups: { title: string; note: string; items: Item[] }[] = [];

for (let gi = 0; gi < groupsMeta.length; gi++) {
  const gm = groupsMeta[gi];
  const ids = COLLECTIONS[collection][gi].ids as readonly string[];
  const items: Item[] = [];
  for (const id of ids) {
    const app = registry.apps.find((a) => a.id === id);
    if (!app) continue; // registry 里没有的（尚未上架）跳过，避免空卡片
    const item = (gm.items as Record<string, { when: string; detail: string }>)[id];
    items.push({
      app,
      when: item?.when ?? '',
      detail: item?.detail ?? taglineFor(app, lang) ?? app.summary ?? '',
    });
  }
  groups.push({ title: gm.title, note: gm.note, items });
}

// 卡片区用的全量应用（按组顺序去重）
const allApps = groups.flatMap((g) => g.items.map((i) => i.app));

const titles: Record<string, { en: string; zh: string }> = {
  coding: {
    en: 'Which AI coding tool should you use? — install with AiBOX | aibox.im',
    zh: 'AI 编程工具怎么选 - AiBOX 一键安装 | aibox.im',
  },
  localModels: {
    en: 'Run AI models on your own computer — install with AiBOX | aibox.im',
    zh: '在自己电脑上跑 AI 模型 - AiBOX 一键安装 | aibox.im',
  },
};
const descs: Record<string, { en: string; zh: string }> = {
  coding: {
    en: 'Seven AI coding tools compared: the one that lives in VS Code, the one that lives in your terminal, the editor with AI built in. All installable with AiBOX.',
    zh: '七个 AI 编程工具横向对比：谁在 VS Code 里、谁在终端里、谁自带编辑器，一眼看清。全部可用 AiBOX 一键安装。',
  },
  localModels: {
    en: 'Run open AI models on your own computer — no API key, no bill, no data leaving your machine. Pick an engine, then a client that talks to it.',
    zh: '在自己电脑上跑开放 AI 模型——不用 API key、不用月费、数据不出机器。先选引擎，再选客户端。',
  },
};
const title = lang === 'zh' ? titles[collection].zh : titles[collection].en;
const description = lang === 'zh' ? descs[collection].zh : descs[collection].en;
---

<BaseLayout lang={lang} title={title} description={description}>
  <PageHeader title={c.title} lede={c.lede} />

  <section class="mx-auto max-w-6xl px-5 py-8">
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <p class="m-0 max-w-2xl text-sm text-aibox-text2">{c.sourceNote}</p>
      <a href={`/${lang}/apps/`} class="btn-ghost">{c.backToCatalog}</a>
    </div>

    {
      allApps.length === 0 ? (
        <p class="m-0 text-aibox-text2">—</p>
      ) : (
        <>
          <h2 class="mt-2 mb-6 font-[family-name:var(--font-display)] text-2xl font-semibold text-aibox-cream">
            {c.pickTitle}
          </h2>

          {groups.map((g) => (
            <div class="mb-10">
              <h3 class="m-0 mb-1 font-[family-name:var(--font-display)] text-lg font-semibold text-aibox-cream">
                {g.title}
              </h3>
              {g.note && <p class="m-0 mb-4 text-sm text-aibox-text2">{g.note}</p>}
              <ol class="m-0 grid list-none gap-3 p-0">
                {g.items.map(({ app, when, detail }, i) => (
                  <li class="border border-aibox-line bg-aibox-raised p-4" style="border-radius:4px">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="font-mono text-xs text-aibox-green">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                      <a
                        href={landingHref(lang, app.id)}
                        class="font-[family-name:var(--font-display)] text-lg font-semibold text-aibox-cream no-underline hover:text-aibox-green"
                      >
                        {app.name}
                      </a>
                    </div>
                    {when && <p class="m-0 mt-1 text-sm text-aibox-text1">{when}</p>}
                    {detail && <p class="m-0 mt-1 text-sm text-aibox-text2">{detail}</p>}
                  </li>
                ))}
              </ol>
            </div>
          ))}

          <PixelRule />

          <h2 class="mt-8 mb-4 font-[family-name:var(--font-display)] text-2xl font-semibold text-aibox-cream">
            {c.title}
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {allApps.map((app) => (
              <AppCard app={app} lang={lang} live={registry.live} href={landingHref(lang, app.id)} />
            ))}
          </div>
        </>
      )
    }

    <div class="mt-12 border border-aibox-line bg-aibox-raised p-6" style="border-radius:4px">
      <h2 class="m-0 mb-2 font-[family-name:var(--font-display)] text-xl font-semibold text-aibox-cream">{c.ctaH}</h2>
      <p class="m-0 mb-4 text-sm text-aibox-text2">{c.sourceNote}</p>
      <a href={`/${lang}/download/`} class="btn-cta">{c.cta}</a>
    </div>
  </section>
</BaseLayout>
