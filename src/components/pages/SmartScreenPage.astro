---
// SmartScreen 图文教程页（en/zh 共用）：四步 + SHA256 + 铁律
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { pt, type Lang } from '../../i18n/pages';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = pt(lang).smartscreen;

const title = lang === 'zh' ? 'Windows SmartScreen 警告怎么办 - 四步继续安装 | aibox.im' : 'Windows SmartScreen warning - continue the install in four steps | aibox.im';
const description =
  lang === 'zh'
    ? '「Windows 已保护你的电脑」四步图文：更多信息 → 仍要运行 → 确认 → 打开。附 SHA-256 校验方法。'
    : '“Windows protected your PC” in four steps: More info → Run anyway → confirm → open. SHA-256 verification included.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <PageHeader title={c.title} lede={c.lede} />

  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="prose-page">
      <div class="panel">
        <h2 class="mt-0 mb-2 text-2xl">{c.intro}</h2>
        <p class="m-0 text-aibox-text2">{c.introBody}</p>
      </div>

      <!-- 四步：纵向时间线（竖线 + 44px 展示数字，非三卡片阵列） -->
      <h2>{c.stepsH}</h2>
      <ol class="relative m-0 list-none border-l border-aibox-line p-0 pl-8">
        {
          c.steps.map((step) => (
            <li class="relative mb-8 last:mb-0">
              <span class="sq absolute -left-[calc(2rem+5px)] top-3 bg-aibox-green" aria-hidden="true" />
              <div class="flex items-baseline gap-4">
                <h3 class="m-0 font-[family-name:var(--font-display)] text-xl font-semibold text-aibox-cream">
                  {step.t}
                </h3>
              </div>
              <p class="mt-1 mb-0 text-aibox-text2">{step.d}</p>
            </li>
          ))
        }
      </ol>

      <div class="panel mt-8">
        <h2 class="mt-0 mb-2 text-2xl">{c.shaH}</h2>
        <p class="text-aibox-text2">{c.shaBody}</p>
        <a class="btn-ghost" href={`/${lang}/download/`}>{c.shaCta} →</a>
      </div>

      <h2>{c.noteH}</h2>
      <p>{c.noteBody}</p>

      <div class="panel mt-8" style="border-color: color-mix(in srgb, var(--aibox-green) 40%, transparent)">
        <h2 class="mt-0 mb-2 text-2xl" style="color: var(--aibox-green)">{c.safetyH}</h2>
        <p class="m-0 text-aibox-cream">{c.safetyBody}</p>
      </div>

      <p class="mt-8">
        <a href={`/${lang}/`} class="text-aibox-info hover:text-aibox-green">← {c.back}</a>
      </p>
    </div>
  </section>
</BaseLayout>
