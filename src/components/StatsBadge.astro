---
// 统计已暂停：保留中性提示，不读取或上报访客统计。
interface Props {
  appId: string;
  /** 打开应用页面时上报一次 view（目录页传 undefined 只展示不上报） */
  lang?: string;
}
const { appId, lang = 'en' } = Astro.props;
---
<span
  class="stats-badge font-mono text-[10px] text-aibox-text2 opacity-70"
  data-stats-app={appId}
  aria-live="polite"
>
  <span class="stats-val">{lang === 'zh' ? '统计已暂停' : 'Stats paused'}</span>
</span>