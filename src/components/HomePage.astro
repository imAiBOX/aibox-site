---
// 首页（en/zh 共用）—— hero 超大字 + 像素机器人方块动画 + 3 步竖向时间线 + registry 真数据卡片
// 视觉母题 =「开箱即用的工具箱」× 品牌绿色系（源自 logo）
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelRule from '../components/PixelRule.astro';
import AppCard from '../components/AppCard.astro';
import { fetchRegistry, LANDING_APP_IDS } from '../data/registry';
import { t, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

// I1 不变式：构建时拉 registry；失败自动降级为内置占位（fetchRegistry 内部容错，绝不抛）
const registry = await fetchRegistry();

const title = lang === 'zh' ? 'AiBOX 智能盒子 - 装到能用为止 | aibox.im' : 'AiBOX - Installed until it works | aibox.im';
const description =
  lang === 'zh'
    ? 'AiBOX 帮完全小白把桌面 AI 工具真正装好：自动体检、按序安装、填好 key、验证能用。绿色免安装，Windows / macOS。'
    : 'AiBOX installs desktop AI tools for you: checks your PC, installs in order, writes your API key and proves it works. Portable, no admin rights.';
---

<BaseLayout lang={lang} title={title} description={description}>
  <!-- ============ HERO（R2 超大字承担层级；主 CTA 绿底黑字） ============ -->
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-5 pt-8 pb-16 md:grid-cols-[1.25fr_1fr] md:pt-14">
    <div>
      <div class="mb-6 flex items-center gap-3">
        <span class="sq bg-aibox-green" aria-hidden="true"></span>
        <span class="font-mono text-xs tracking-widest text-aibox-text2 uppercase">AiBOX.im / {d.brandSub}</span>
      </div>
      <h1 class="hero-title m-0">{d.hero.title}</h1>
      <p class="mt-6 max-w-xl text-lg text-aibox-text2">{d.hero.lede}</p>

      <div class="mt-8 flex flex-wrap items-center gap-6">
        <a class="btn-cta no-underline" href={`/${lang}/download/`}>
          <span>{d.hero.cta}</span>
          <span class="mono" aria-hidden="true">↓</span>
        </a>
        <a class="btn-ghost" href={`/${lang}/apps/`}>{d.hero.secondary} ↓</a>
      </div>
      <p class="mt-4 font-mono text-xs text-aibox-text2">{d.hero.ctaHint}</p>
    </div>

    <div class="justify-self-center md:justify-self-end">
      <!-- 主视觉 = 标准 lockup（图标+字标整体品牌标记）；尺寸克制，禁卡片/渐变包裹 -->
      <picture>
        <source srcset="/images/logo-lockup.webp" type="image/webp" />
        <img
          src="/images/logo-lockup.png"
          alt={d.hero.logoAlt}
          width="840"
          height="838"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block w-full max-w-[420px]"
        />
      </picture>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5"><PixelRule length={32} every={4} /></div>

  <!-- ============ 3 步：竖向时间线（禁三等宽卡片阵列；完成态绿方点） ============ -->
  <section class="mx-auto max-w-6xl px-5 py-14" id="steps">
    <h2 class="h-section m-0 mb-10">{d.steps.title}</h2>
    <ol class="relative m-0 list-none border-l border-aibox-line p-0 pl-10">
      {d.steps.items.map((step, i) => (
        <li class="relative mb-10 last:mb-0">
          <span
            class="sq absolute -left-[calc(2.5rem+5px)] top-2"
            style={`background:${i === d.steps.items.length - 1 ? 'var(--aibox-ok)' : 'var(--aibox-green)'}`}
            aria-hidden="true"
          >
          </span>
          <div class="mb-1 flex items-baseline gap-4">
            <span class="font-mono text-sm text-aibox-text2">0{i + 1}</span>
            <h3 class="m-0 font-[family-name:var(--font-display)] text-2xl font-semibold text-aibox-cream">{step.t}</h3>
          </div>
          <p class="m-0 max-w-2xl text-aibox-text2">{step.d}</p>
          {i === d.steps.items.length - 1 && (
            <span class="badge badge-ok mt-2">✓ {d.steps.done}</span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ 主推应用区（registry 真数据卡片 + I1 失败降级占位） ============ -->
  <section class="mx-auto max-w-6xl px-5 py-14" id="apps">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="h-section m-0 mb-2">{d.catalog.title}</h2>
        <p class="m-0 max-w-2xl text-sm text-aibox-text2">{d.catalog.lede}</p>
      </div>
      <span class={`badge ${registry.live ? 'badge-green' : 'badge-info'}`}>
        <span class="sq" style={`background:${registry.live ? 'var(--aibox-green)' : 'var(--aibox-info)'}`}></span>
        {registry.live ? d.catalog.sourceLive : d.catalog.sourceFallback}
      </span>
    </div>

    {registry.apps.length === 0 ? (
      <p class="border border-dashed border-aibox-line p-6 text-aibox-text2" style="border-radius:4px">{d.catalog.empty}</p>
    ) : (
      <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(260px,1fr))]">
        {registry.apps.map((app) => (
          <AppCard
            app={app}
            lang={lang}
            live={registry.live}
            href={LANDING_APP_IDS.includes(app.id) ? `/${lang}/apps/${app.id}/` : undefined}
          />
        ))}
      </div>
    )}

    <p class="mt-8 mb-0">
      <a href={`/${lang}/apps/`} class="text-aibox-info no-underline hover:text-aibox-green">{d.catalog.title} →</a>
    </p>
  </section>
</BaseLayout>
