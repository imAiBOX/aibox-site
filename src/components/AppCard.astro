---
// 应用目录卡片（registry 数据渲染；4px 圆角、禁玻璃拟态/大圆角）
import type { RegistryApp } from '../data/registry';
import StatsBadge from './StatsBadge.astro';
import { taglineFor } from '../data/registry';
import type { Lang } from '../i18n/dict';
import { t } from '../i18n/dict';

interface Props {
  app: RegistryApp;
  lang: Lang;
  live: boolean;
  /** 落地页链接（所有 registry 应用均有模板化落地页；无则整卡不可点） */
  href?: string;
}
const { app, lang, live, href } = Astro.props;
const d = t(lang);
const summary = taglineFor(app, lang) ?? app.summary;

const platformName: Record<string, string> = { win: 'Windows', windows: 'Windows', mac: 'macOS', macos: 'macOS', darwin: 'macOS', linux: 'Linux' };
const statusMap: Record<string, { label: string; cls: string }> = {
  available: { label: 'available', cls: 'badge-ok' },
  ready: { label: 'ready', cls: 'badge-ok' },
  installable: { label: 'installable', cls: 'badge-ok' },
  stable: { label: 'stable', cls: 'badge-ok' },
  preview: { label: 'preview', cls: 'badge-info' },
  building: { label: 'building', cls: 'badge-info' },
  planned: { label: 'planned', cls: '' },
};
const status = app.status ? statusMap[app.status.toLowerCase()] ?? { label: app.status, cls: '' } : { label: '—', cls: '' };
const level = app.difficulty ?? 0;
const Tag = href ? 'a' : 'article';
---
<Tag
  href={href}
  class="flex h-full flex-col gap-3 border border-aibox-line bg-aibox-raised p-4 text-aibox-text1 no-underline transition-colors hover:border-aibox-green-d"
  style="border-radius:4px"
>
  <div class="flex items-center justify-between gap-2">
    <h3 class="m-0 font-[family-name:var(--font-display)] text-xl font-semibold text-aibox-cream">{app.name}</h3>
            <StatsBadge appId={app.id} lang={lang} />
    <span class="sq" style={`background:${status.cls === 'badge-ok' ? 'var(--aibox-ok)' : status.cls === 'badge-info' ? 'var(--aibox-info)' : 'var(--aibox-line)'}`} aria-hidden="true"></span>
  </div>
  {summary && <p class="m-0 text-sm text-aibox-text2">{summary}</p>}
  <dl class="m-0 mt-auto grid gap-2 text-xs">
    <div class="flex items-center justify-between gap-2">
      <dt class="text-aibox-text2">{d.catalog.difficulty}</dt>
      <dd class="m-0 font-mono text-aibox-text1" title={`${level}/5`}>
        {Array.from({ length: 5 }, (_, i) => (
          <span style={`color:${i < level ? 'var(--aibox-green)' : 'var(--aibox-line)'}`}>{i < level ? '●' : '○'}</span>
        ))}
      </dd>
    </div>
    <div class="flex items-center justify-between gap-2">
      <dt class="text-aibox-text2">{d.catalog.platforms}</dt>
      <dd class="m-0 flex flex-wrap justify-end gap-1">
        {(app.platforms?.length ? app.platforms : ['—']).map((p) => (
          <span class="badge">{platformName[p.toLowerCase()] ?? p}</span>
        ))}
      </dd>
    </div>
    <div class="flex items-center justify-between gap-2">
      <dt class="text-aibox-text2">{d.catalog.status}</dt>
      <dd class="m-0"><span class={`badge ${status.cls}`}>{status.label}</span>{!live && <span class="badge ml-1">mock</span>}</dd>
    </div>
  </dl>
  {href && (
    <p class="m-0 mt-1 font-mono text-xs text-aibox-info">
      {lang === 'zh' ? '查看教程' : 'View guide'} →
    </p>
  )}
</Tag>
