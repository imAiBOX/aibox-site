---
// 只引 latin 子集 + font-display: optional（自写 @font-face，见 styles/fonts.css）
import '../styles/fonts.css';
// 字体 preload：与 HTML 并行，让 optional 字体尽量在短阻塞期内到位
import sgWoff from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import monoWoff from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import handjetWoff from '@fontsource/handjet/files/handjet-latin-400-normal.woff2?url';
import '../styles/global.css';
import { t, langLabel, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** 页面专属 JSON-LD（FAQPage 等）；站点级 WebSite 由本 layout 统一输出 */
  jsonLd?: Record<string, unknown>[];
  /** 首页 LCP = hero lockup 图；首页才 preload（其他页预载无用图会拖分） */
  preloadLcp?: boolean;
  /** 从 sitemap/页面集合排除（根分流页用） */
  noindex?: boolean;
}
const { lang, title, description, jsonLd = [], noindex = false, preloadLcp = false } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'zh' : 'en';
const path = Astro.url.pathname;
// hreflang/canonical 用生产域做规范（开发期在 pages.dev，但 SEO 按 aibox.im 输出）
const SITE = 'https://aibox.im';
// 构建期注入的内容日期信号（content signals）
const buildTime = new Date().toISOString();
const otherPath = (path.replace(`/${lang}/`, `/${other}/`) || `/${other}/`) as string;
const canonical = `${SITE}${path}`;

// 站点级 WebSite JSON-LD
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AiBOX.im',
  alternateName: ['AiBOX', '智能盒子'],
  url: SITE,
  inLanguage: ['en', 'zh'],
  description,
  publisher: {
    '@type': 'Organization',
    name: 'imAiBOX',
    url: 'https://github.com/imAiBOX',
  },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      preloadLcp && (
        <link
          rel="preload"
          as="image"
          type="image/webp"
          href="/images/logo-lockup-420.webp"
          imagesrcset="/images/logo-lockup-420.webp 420w, /images/logo-lockup.webp 840w"
          imagesizes="420px"
          fetchpriority="high"
        />
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preload" as="font" type="font/woff2" href={sgWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={monoWoff} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={handjetWoff} crossorigin />
    <link rel="canonical" href={canonical} />
    <!-- llms.txt 关联（llms.txt 规范：首页声明）+ 内容日期信号 -->
    <link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />
    <meta property="article:modified_time" content={buildTime} />
    <!-- hreflang：zh/en 互指（绝对地址，生产域规范） -->
    <link rel="alternate" hreflang="en" href={`${SITE}${path.replace(`/${lang}/`, '/en/')}`} />
    <link rel="alternate" hreflang="zh" href={`${SITE}${path.replace(`/${lang}/`, '/zh/')}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE}${path.replace(`/${lang}/`, '/en/')}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AiBOX.im" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <!-- OG 卡片：1200×630 黑底 + 标准 lockup（品牌位 = 图标+字标整体呈现） -->
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AiBOX.im" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-screen bg-aibox-bg text-aibox-text1">
    <!-- 质感层：SVG 噪点（禁渐变横幅/玻璃拟态） -->
    <div class="grain" aria-hidden="true"></div>

    <header class="relative mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-5">
      <a href={`/${lang}/`} class="flex items-center gap-2.5 no-underline">
        <!-- 导航小尺寸位 = 只用图标（字标在小尺寸不可读，用文字排版补） -->
        <img src="/images/icon-64.png" width="32" height="32" alt="" class="h-8 w-8" decoding="async" />
        <span class="brand-pixel text-2xl text-aibox-cream">AiBOX.im</span>
        <span class="badge hidden sm:inline-flex">{d.brandSub}</span>
      </a>
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <a href={`/${lang}/apps/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.catalog}</a>
        <a href={`/${lang}/download/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.download}</a>
        <a href={`/${lang}/faq/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.faq}</a>
        <a href={`/${lang}/about/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.about}</a>
        <a href={otherPath} hreflang={other} class="badge badge-green no-underline" rel="alternate">{langLabel[other]}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="relative mx-auto mt-20 max-w-6xl border-t border-aibox-line px-5 py-10 text-sm text-aibox-text2">
      <div class="mb-4 pixel-rule" aria-hidden="true">
        {Array.from({ length: 16 }, (_, i) => <i class={i % 4 === 0 ? 'on' : ''}></i>)}
      </div>

      <!-- 页脚品牌区：icon-only 小图 + AiBOX.im 文字 + 独立声明 -->
      <div class="mb-4 flex items-center gap-2.5">
        <img src="/images/icon-64.png" width="28" height="28" alt="" class="h-7 w-7" loading="lazy" decoding="async" />
        <span class="brand-pixel text-xl text-aibox-cream">AiBOX.im</span>
      </div>

      <p class="mb-4 max-w-3xl text-sm text-aibox-cream">{d.footer.independent}</p>

      <div class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <a href={`/${lang}/download/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.download}</a>
        <a href={`/${lang}/faq/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.faq}</a>
        <a href={`/${lang}/about/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.about}</a>
        <a href={`/${lang}/privacy/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.privacy}</a>
        <a href={`/${lang}/feedback/`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.feedback}</a>
        <a href="/openapi.json" class="text-aibox-text2 no-underline hover:text-aibox-green">API</a>
        <a
          href="https://github.com/imAiBOX"
          class="text-aibox-text2 no-underline hover:text-aibox-green"
          rel="noopener noreferrer"
          target="_blank">{d.footer.github} ↗</a
        >
      </div>

      <!-- AI-Friendly 评分徽章（AiApp.im 官方动态 SVG，随分数自动更新） -->
      <a
        href="https://afr.im/site/aibox.im"
        class="inline-block opacity-90 transition-opacity hover:opacity-100"
        rel="noopener noreferrer"
        target="_blank"
      >
        <img
          src="https://afr.im/badge/aibox.im.svg"
          alt="AI-Friendly Rating"
          height="20"
          width="118"
          loading="lazy"
          decoding="async"
        />
      </a>

      <p class="mb-1 font-mono text-xs">{d.footer.phase}</p>
      <p class="text-xs">{d.footer.copy}</p>
      <div class="mt-4 flex gap-3">
        <a href="/en/" hreflang="en" class="badge no-underline">English</a>
        <a href="/zh/" hreflang="zh" class="badge no-underline">中文</a>
      </div>
    </footer>
  </body>
</html>
