---
import '@fontsource/space-grotesk/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/handjet/400.css';
import '../styles/global.css';
import { t, langLabel, type Lang } from '../i18n/dict';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'zh' : 'en';
const path = Astro.url.pathname;
const otherPath = path.replace(`/${lang}/`, `/${other}/`) || `/${other}/`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- hreflang：zh/en 互指 -->
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="zh" href="/zh/" />
    <link rel="alternate" hreflang="x-default" href="/en/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen bg-aibox-bg text-aibox-text1">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-5">
      <a href={`/${lang}/`} class="flex items-baseline gap-2 no-underline">
        <span class="brand-pixel text-2xl text-aibox-cream">AiBOX.im</span>
        <span class="badge">{d.brandSub}</span>
      </a>
      <nav class="flex items-center gap-5 text-sm">
        <a href={`/${lang}/#apps`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.catalog}</a>
        <a href={`/${lang}/#download-note`} class="text-aibox-text2 no-underline hover:text-aibox-green">{d.nav.download}</a>
        <a href={otherPath} hreflang={other} class="badge badge-green no-underline">{langLabel[other]}</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mx-auto mt-20 max-w-6xl border-t border-aibox-line px-5 py-8 text-sm text-aibox-text2">
      <div class="mb-3 pixel-rule" aria-hidden="true">
        {Array.from({ length: 16 }, (_, i) => <i class={i % 4 === 0 ? 'on' : ''}></i>)}
      </div>
      <p class="mb-1 font-mono text-xs">{d.footer.phase}</p>
      <p class="text-xs">{d.footer.copy}</p>
    </footer>
  </body>
</html>
