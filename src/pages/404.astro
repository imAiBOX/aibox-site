---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en"
  title="Page not found | AiBOX.im"
  description="The page you are looking for does not exist."
  noindex={true}
>
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-start justify-center px-5 py-20">
    <p class="mb-4 font-mono text-sm text-aibox-green">404</p>
    <h1 class="mb-4 text-4xl font-semibold text-aibox-cream md:text-5xl">Page not found</h1>
    <p class="mb-8 max-w-xl text-aibox-text2">
      The page you are looking for does not exist or has moved. Try the catalog or go back home.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/en/"
        class="inline-block rounded bg-aibox-green px-5 py-2.5 font-medium text-aibox-bg no-underline hover:bg-aibox-green-d"
        >Home</a
      >
      <a
        href="/en/apps/"
        class="inline-block rounded border border-aibox-line px-5 py-2.5 font-medium text-aibox-cream no-underline hover:border-aibox-green"
        >App catalog</a
      >
    </div>
  </main>
</BaseLayout>
